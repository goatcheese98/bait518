{
  "name": "bait518",
  "compatibility_date": "2025-10-23",
  "assets": {
    "directory": "./wages-viz-app/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "main": "./wages-viz-app/runtime/worker.ts",
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false
  }
}
