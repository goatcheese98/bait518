{
  "name": "wages-viz-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build-only && npm run type-check",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "test:lint-contract": "node tools/lint-contract.mts",
    "runtime:local": "wrangler dev --config ../wrangler.jsonc --local --ip 127.0.0.1 --port 4173 --inspector-port 0 --show-interactive-dev-session=false",
    "runtime:dry-run": "wrangler deploy --config ../wrangler.jsonc --dry-run"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "pinia": "^3.0.3",
    "swiper": "^12.2.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.18.11",
    "@types/papaparse": "5.3.16",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.1",
    "wrangler": "4.151.2"
  }
}
